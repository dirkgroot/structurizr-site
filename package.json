{
  "name": "structurizr-site",
  "version": "0.2.0-pre-alpha.4",
  "description": "Static site generator for Structurizr workspaces",
  "type": "module",
  "license": "MIT",
  "author": "Dirk Groot",
  "homepage": "https://github.com/dirkgroot/structurizr-site#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkgroot/structurizr-site.git"
  },
  "bugs": {
    "url": "https://github.com/dirkgroot/structurizr-site/issues"
  },
  "keywords": [
    "structurizr",
    "c4",
    "architecture",
    "architecture-diagrams",
    "static-site-generator"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run build:cli && bun run build:web && bun run build:binary",
    "build:cli": "bun build src/cli/bin.ts --target=node --format=esm --sourcemap=linked --outdir=dist/cli",
    "build:web": "vite build",
    "build:binary": "bun packaging/binary/build.mjs",
    "build:binary:all": "bun packaging/binary/build.mjs --all",
    "watch": "vite",
    "typecheck": "tsc -p tsconfig.cli.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:workspace-types": "bunx openapi-typescript@7.13.0 src/shared/workspace/structurizr.yaml -o src/shared/workspace/schema.d.ts",
    "clean": "rm -rf dist build",
    "changelog": "git cliff --output CHANGELOG.md",
    "changelog:release": "git cliff --tag \"v$(bun -p 'require(\"./package.json\").version')\" --output CHANGELOG.md",
    "generate": "bun dist/cli/bin.js generate"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.51.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
