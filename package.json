{
  "name": "structurizr-site",
  "version": "0.1.0",
  "description": "Static site generator for Structurizr workspaces",
  "type": "module",
  "license": "MIT",
  "author": "Dirk Groot",
  "homepage": "https://github.com/dirkgroot/structurizr-site#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkgroot/structurizr-site.git"
  },
  "bugs": {
    "url": "https://github.com/dirkgroot/structurizr-site/issues"
  },
  "keywords": [
    "structurizr",
    "c4",
    "architecture",
    "architecture-diagrams",
    "static-site-generator"
  ],
  "bin": {
    "structurizr-site": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:spa",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:spa": "vite build",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.spa.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "rm -rf dist build",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint",
    "generate-site": "node dist/cli/bin.js generate-site"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
