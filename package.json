{
  "name": "structurizr-site",
  "version": "0.1.0",
  "description": "Static site generator for Structurizr workspaces",
  "type": "module",
  "license": "MIT",
  "author": "Dirk Groot",
  "homepage": "https://github.com/dirkgroot/structurizr-site#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkgroot/structurizr-site.git"
  },
  "bugs": {
    "url": "https://github.com/dirkgroot/structurizr-site/issues"
  },
  "keywords": [
    "structurizr",
    "c4",
    "architecture",
    "architecture-diagrams",
    "static-site-generator"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:spa && npm run build:binary",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:spa": "vite build",
    "build:binary": "node packaging/binary/build.mjs",
    "build:binary:all": "node packaging/binary/build.mjs --all",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.spa.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "rm -rf dist build",
    "generate-site": "node dist/cli/bin.js generate-site"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
