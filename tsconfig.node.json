{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/web/*"],
      "@shared/*": ["./src/shared/*"],
      // `@shared/workspace` is a directory import; tsc's path substitution does not
      // fall through to its `index.ts`, so map it explicitly for the extensionless form.
      "@shared/workspace": ["./src/shared/workspace/index.ts"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "dev/**/*.ts"]
}
