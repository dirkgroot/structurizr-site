{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/web/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "test/**/*.ts", "dev/**/*.ts"]
}
