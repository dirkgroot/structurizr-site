{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/web/*"],
      "@shared/*": ["./src/shared/*"],
      // `@shared/workspace` is a directory import: tsc's path substitution does not
      // fall through to its `index.ts`, so map it explicitly for the extensionless form.
      "@shared/workspace": ["./src/shared/workspace/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
